# Copy to .env for a standalone deployment. (BoxPilot sets these itself.)
LLMCOACH_PORT=8420
LLMCOACH_USERNAME=owner
# Sign-in is disabled while this is empty.
LLMCOACH_PASSWORD=
# Keeps sessions valid across restarts. Generate with: openssl rand -hex 32
LLMCOACH_SESSION_SECRET=
# LLMCOACH_OLLAMA_URL=http://host.docker.internal:11434
